            <Entry Text="{Binding MyMessage}" Placeholder="Type your message" FontSize="18" HorizontalOptions="Center" />

            <Button Text="Send" Style="{x:StaticResource ConerButtonStyle}" Command="{Binding ButtonClickCommand}" HorizontalOptions="Center" />-->
