<?xml version="1.0" encoding="utf-8" ?>
<baseviews:ViewBase 
            xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatHub.Views.BaseMapPage"
             xmlns:baseviews="clr-namespace:ChatHub.Views.Base"
             xmlns:viewmodels="clr-namespace:ChatHub.ViewModels"
             x:TypeArguments="viewmodels:BaseMapViewModel"
             x:DataType="viewmodels:BaseMapViewModel"
             xmlns:zoft="http://zoft.MauiExtensions/Controls"
             xmlns:esriUI="clr-namespace:Esri.ArcGISRuntime.Maui;assembly=Esri.ArcGISRuntime.Maui"
             xmlns:model="clr-namespace:ChatHub.Models"
             PageTitle="{Binding Title, Mode=OneWay}"
             PageMode="None"
             ContentDisplayMode="NoNavigationBar">
    <!--<baseviews:ViewBase.PageContent>-->

    <Grid RowDefinitions="auto,auto,*">
        <SearchBar  Grid.Row="0" x:Name="txtSearchQuery" SearchCommand="{Binding TextChangedCommand}" SearchCommandParameter="{Binding Path=Text, Source={x:Reference txtSearchQuery}, Mode=OneWay}"></SearchBar>
        <ListView x:Name="SuggestionListView" IsVisible="True" Grid.Row="1" ItemsSource="{Binding FilteredList}" SelectionMode="Single" ItemSelected="onItemSelected">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:Suggestions">
                    <ViewCell>
                        <Label Text="{Binding Name}" VerticalOptions="Center" HorizontalOptions="CenterAndExpand"></Label>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <!--<zoft:AutoCompleteEntry  Grid.Row="0" Placeholder="Search Address"  HeightRequest="60" ItemsSource="{Binding FilteredList}" TextMemberPath="Name"  DisplayMemberPath="Name"  TextChangedCommand="{Binding TextChangedCommand}" SelectedSuggestion="{Binding SelectedItem}"/>-->
        <esriUI:MapView Grid.Row="2" Map="{Binding BaseMap}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" GraphicsOverlays="{Binding BaseGrapchicsOverlays}" />
    </Grid>
    <!--</baseviews:ViewBase.PageContent>-->
</baseviews:ViewBase>