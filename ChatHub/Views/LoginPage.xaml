<?xml version="1.0" encoding="utf-8" ?>
<baseviews:ViewBase
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatHub.Views.LoginPage"
             xmlns:baseviews="clr-namespace:ChatHub.Views.Base"
             xmlns:viewmodels="clr-namespace:ChatHub.ViewModels"
             x:TypeArguments="viewmodels:LoginPageViewModel"
             x:DataType="viewmodels:LoginPageViewModel"
             PageTitle="{Binding Title, Mode=OneWay}"
             PageMode="None"
             ContentDisplayMode="NoNavigationBar" >
    <baseviews:ViewBase.PageContent>
        <VerticalStackLayout  Padding="0,0" Spacing="25" BackgroundColor="Red">
            <Button Text="nnnn" Command="{Binding ButtonClickCommand}" BackgroundColor="Orange" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </baseviews:ViewBase.PageContent>
</baseviews:ViewBase>