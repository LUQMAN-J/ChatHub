<?xml version="1.0" encoding="utf-8" ?>
<baseviews:ViewBase 
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatHub.Views.RegisterPage"
             xmlns:baseviews="clr-namespace:ChatHub.Views.Base"
             xmlns:viewmodels="clr-namespace:ChatHub.ViewModels"
             x:TypeArguments="viewmodels:RegisterPageViewModel"
             x:DataType="viewmodels:RegisterPageViewModel"
             PageTitle="{Binding Title, Mode=OneWay}"
             PageMode="Menu"
             ContentDisplayMode="NavigationBar">
    <baseviews:ViewBase.PageContent>
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
    </VerticalStackLayout>
    </baseviews:ViewBase.PageContent>
</baseviews:ViewBase>