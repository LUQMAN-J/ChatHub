<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    ios:Page.PrefersHomeIndicatorAutoHidden="true"
    xmlns:basecontrols="clr-namespace:ChatHub.ViewControls.Common"
    xmlns:Animations="clr-namespace:ChatHub.ViewControls.JsonAnimation"
    Shell.NavBarIsVisible="False"
    x:Class="ChatHub.Views.Base.PageBase"
    BackgroundColor="{StaticResource PageBackgroundColor}">

    <Grid
        IgnoreSafeArea="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="{OnPlatform Android=0, iOS=36, Default=0}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

              <!-- Grid to contain Page Content -->
        <Grid
            InputTransparent="{Binding IsBusy, Mode=OneWay}"
            x:Name="PageContentGrid"
            IgnoreSafeArea="True"/>

        <!-- Busy Indicator -->
        <basecontrols:LoadingIndicator
            Grid.Row="2"
            IsBusy="{Binding IsBusy, Mode=OneWay}"
            LoadingText="{Binding LoadingText, Mode=OneWay}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />




        <!-- Page Header -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="56,*,56"
            Margin="0,4"
            IgnoreSafeArea="True">

            <!-- Icons for Left Side -->

            <Animations:LeftArrowView x:Name="NavigateBackButton" Margin="0,1,0,1" Grid.Column="0" Padding="5,0,0,0"  HorizontalOptions="Start"  VerticalOptions="Center"/>
            <Animations:CrossSignView x:Name="CloseButton" Margin="0,1,0,1" Grid.Column="0" Padding="2,0,0,0"  HorizontalOptions="Start"  VerticalOptions="Center"/>
            <Animations:BackCrossSignView x:Name="HamburgerButton" Margin="0,1,0,1" Grid.Column="0" Padding="2,0,0,0"  HorizontalOptions="Start"  VerticalOptions="Center"/>



         

            <!-- Page Header Label -->
            <Label
         
                Grid.Column="1"
                x:Name="TitleLabel"
                IsVisible="False"
                VerticalOptions="Center"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                Margin="6,0,6,-1"
                Style="{StaticResource PageHeaderTextStyle}" />

            <!-- Icons for Right Side -->
            <Grid
                x:Name="PageIconsGrid"
                Grid.Column="2"
                Margin="0,4"
                VerticalOptions="Center"
                HorizontalOptions="End" />

        </Grid>

    </Grid>

</ContentPage>
