	  </MauiXaml>
	  <MauiXaml Update="ViewControls\JsonAnimation\BackCrossSignView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="ViewControls\JsonAnimation\CrossSignView.xaml">
