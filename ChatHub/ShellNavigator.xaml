<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatHub.ShellNavigator"
             xmlns:local="clr-namespace:ChatHub.Views"
             Shell.FlyoutBehavior="Disabled"
             Shell.TabBarTitleColor="{x:StaticResource AppRedColor}"
             Shell.PresentationMode="Animated"
             Shell.NavBarHasShadow="True"
             Shell.TabBarBackgroundColor="#FFF5EE"
             Shell.TabBarForegroundColor="{x:StaticResource AppRedColor}"
             Title="ShellNavigator">
    <ShellContent     Title="FindStore"
                      Route="_FindStore"
                      ContentTemplate="{DataTemplate local:FindStore}" />
    <TabBar>
        <Tab Title="Home" Icon="homeicon.png" Route="_HomeNav">
            <ShellContent ContentTemplate="{DataTemplate local:HomePage}" />
        </Tab>
        <Tab Title="Chat" Icon="chaticon.png" Route="_ChatNav">
            <ShellContent ContentTemplate="{DataTemplate local:ChatPage}" />
        </Tab>
    </TabBar>
</Shell>
