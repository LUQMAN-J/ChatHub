<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="ChatHub.ViewControls.JsonAnimation.BackCrossSignView">
    <ContentView.GestureRecognizers>
        <TapGestureRecognizer Command="{Binding BindingContext.NavigateToBackCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"  />
    </ContentView.GestureRecognizers>
    <VerticalStackLayout>
        <controls:SKLottieView
          RepeatCount="-1"
          HeightRequest="38"
          WidthRequest="50"
          Source="crosssign.json"  />
    </VerticalStackLayout>
</ContentView>
