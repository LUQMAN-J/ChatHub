<?xml version="1.0" encoding="utf-8" ?>
<mopup:PopupPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ChatHub.ViewControls.Common.ErrorIndicator"
    xmlns:mopup="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:controls="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    xmlns:mopupsanim="clr-namespace:Mopups.Animations;assembly=Mopups"
    CloseWhenBackgroundIsClicked="False">
    <mopup:PopupPage.Animation>
        <mopupsanim:ScaleAnimation
            DurationIn="700"
            EasingIn="BounceOut"
            PositionIn="Bottom"
            PositionOut="Center"
            ScaleIn="1"
            ScaleOut="1" />
    </mopup:PopupPage.Animation>
    <Frame WidthRequest="300" HeightRequest="300" Padding="5" Margin="0">
        <VerticalStackLayout>
            <VerticalStackLayout HorizontalOptions="EndAndExpand" Padding="0" Margin="0">
                <controls:SKLottieView RepeatCount="-1" HeightRequest="38" WidthRequest="50"   Source="crosssign.json"  />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer   Tapped="OnBackGroundClick"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
            <controls:SKLottieView
         Padding="0"
         Margin="0"
         x:Name="imgError"
         RepeatCount="-1"
         HeightRequest="50"
         WidthRequest="50"  />

            <Label
        x:Name="lblheadertitle"
        Margin="0,5,0,0"
        FontAttributes="Bold"
        TextColor="Red"
        HorizontalOptions="Center"
        HorizontalTextAlignment="Center" />

            <Label
        x:Name="lblErrorText"
        TextColor="Red"
        FontAutoScalingEnabled="False"
        LineBreakMode="WordWrap"
        HorizontalOptions="Center"
        HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Frame>

</mopup:PopupPage>

